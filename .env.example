# Pulse SSE 数据流地址, Cloudflare Pages 可在项目环境变量中覆盖
VITE_PULSE_EVENTS_URL=https://example.com/api/events

# 可选共享 token, 设置后会自动作为 token 查询参数附加
VITE_PULSE_SHARE_TOKEN=
# 是否携带跨域凭据
VITE_PULSE_WITH_CREDENTIALS=false
# SSE 重连初始等待时间, 单位为毫秒
VITE_PULSE_RECONNECT_DELAY=3000

# 可选的站点元信息和界面设置
VITE_SITE_TITLE=Pulse-theme-purcarte
VITE_SITE_DESCRIPTION=Pulse server monitoring dashboard.
VITE_THEME_COLOR=violet
VITE_DEFAULT_VIEW=grid
VITE_DEFAULT_APPEARANCE=system
VITE_ENABLE_SEARCH=true
VITE_ENABLE_TAGS_BAR=true
# 默认标签, 留空表示显示所有节点
VITE_DEFAULT_TAG=
